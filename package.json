{
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "traceability": "node --permission --allow-fs-read=. --allow-addons tools/traceability/src/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "content-check": "node --permission --allow-fs-read=. tools/content-check/src/main.js",
    "content-shape": "node tools/content-check/src/generate-shape.ts"
  },
  "devDependencies": {
    "@jsonresume/schema": "1.3.1",
    "@types/node": "^26.6.5",
    "jsonc-parser": "3.3.1",
    "jsonschema": "1.5.0",
    "oxc-parser": "0.155.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
