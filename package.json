{
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "traceability": "node --permission --allow-fs-read=. --allow-addons tools/traceability/src/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/web/src/sw/tsconfig.json",
    "content-check": "node --permission --allow-fs-read=. tools/content-check/src/main.js",
    "content-shape": "node tools/content-check/src/generate-shape.ts",
    "token-check": "node --permission --allow-fs-read=. --allow-addons tools/token-check/src/main.js",
    "token-output": "node tools/token-check/src/generate-output.ts",
    "build": "node packages/web/scripts/build-site.ts",
    "serve": "node tools/site-check/src/server.ts",
    "site-check": "npm run build && node tools/site-check/src/main.js"
  },
  "devDependencies": {
    "@jsonresume/schema": "1.3.1",
    "@types/css-tree": "3.2.0",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "chrome-launcher": "1.2.2",
    "css-tree": "3.2.1",
    "expr-eval-fork": "3.0.3",
    "jsonc-parser": "3.3.1",
    "jsonschema": "1.5.0",
    "lighthouse": "13.5.0",
    "lightningcss": "1.33.0",
    "oxc-parser": "0.155.0",
    "pdfjs-dist": "6.4.299",
    "playwright": "1.64.1",
    "postcss": "8.5.31",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  }
}
