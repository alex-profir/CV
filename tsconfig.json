{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "types": ["node"],
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "lib": ["esnext", "dom", "dom.iterable"]
  },
  "include": [
    "tools/**/*.ts",
    "tools/**/*.js",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "vitest.config.ts"
  ],
  "exclude": ["**/__fixtures__/**", "packages/web/src/sw/**"]
}
