{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": ["tools/**/*.ts", "tools/**/*.js", "packages/**/*.ts", "vitest.config.ts"],
  "exclude": ["**/__fixtures__/**"]
}
