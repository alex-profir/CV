{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Site data",
  "description": "Data only the site needs. CV facts belong in resume.json.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "featuredProjects": {
      "type": "array",
      "items": {
        "type": "string",
        "x-cv-reference": "project"
      }
    },
    "contact": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "x-cv-reference": "profile"
        },
        "email": {
          "type": "string",
          "format": "email"
        }
      }
    },
    "highlight": {
      "type": "object",
      "x-cv-reference": "work",
      "properties": {
        "name": {
          "type": "string"
        },
        "position": {
          "type": "string"
        },
        "startDate": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "position",
        "startDate"
      ]
    },
    "pastHighlight": {
      "type": "object",
      "x-cv-reference": "work",
      "properties": {
        "name": {
          "type": "string"
        },
        "position": {
          "type": "string"
        },
        "startDate": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "position",
        "startDate"
      ]
    }
  }
}
